      "start": 41.4,
      "end": 43.9,
      "treatment": "balance-offering",
      "lyrics": "as an offering to the Lord."
    },
    {
      "id": "g4-scene-009",
      "start": 43.9,
      "end": 49.36666666666667,
      "treatment": "camera-wall",
      "lyrics": "Abel brought the firstborn of his sheep, and his fatlings."
    },
    {
      "id": "g4-scene-011",
      "start": 49.36666666666667,
      "end": 55.03333333333333,
      "treatment": "camera-rack",
      "lyrics": "God looked upon Abel and his gifts."
    },
    {
      "id": "g4-scene-012",
      "start": 55.03333333333333,
      "end": 61.3,
      "treatment": "refusal-bar",
      "lyrics": "But Cain and his sacrifices He did not regard."
    },
    {
      "id": "g4-scene-014",
      "start": 61.3,
      "end": 63.96666666666667,
      "treatment": "falling-weight",
      "lyrics": "Cain was deeply grieved;"
    },
    {
      "id": "g4-scene-015",
      "start": 63.96666666666667,
      "end": 66.66666666666667,
      "treatment": "camera-stairwell",
      "lyrics": "his face fell low."
    },
    {
      "id": "g4-scene-016",
      "start": 66.66666666666667,
      "end": 70.4,
      "treatment": "camera-dolly",
      "lyrics": "The Lord God asked Cain,"
    },
    {
      "id": "g4-scene-017",
      "start": 70.4,
      "end": 73.16666666666667,
      "treatment": "negative-space",
      "lyrics": "Why are you so sorrowful?"
    },
    {
      "id": "g4-scene-018",
      "start": 73.16666666666667,
      "end": 76.7,
      "treatment": "stone-crush",
      "lyrics": "Why has your face fallen?"
    },
    {
      "id": "g4-scene-019",
      "start": 76.7,
      "end": 79.5,
      "treatment": "camera-runway",
      "lyrics": "If you brought it rightly"
    },
    {
      "id": "g4-scene-020",
      "start": 79.5,
      "end": 81.8,
      "treatment": "split-verdict",
      "lyrics": "but did not divide it rightly,"
    },
    {
      "id": "g4-scene-021",
      "start": 81.8,
      "end": 84.33333333333333,
      "treatment": "incision",
      "lyrics": "have you not sinned?"
    },
    {
      "id": "g4-scene-022",
      "start": 84.33333333333333,
      "end": 86.93333333333334,
      "treatment": "breath-resolve",
      "lyrics": "Be still; he shall submit to you,"
    },
    {
      "id": "g4-scene-023",
      "start": 86.93333333333334,
      "end": 91.53333333333333,
      "treatment": "camera-horizon",
      "lyrics": "and you shall rule over him."
    },
    {
      "id": "g4-scene-024",
      "start": 91.53333333333333,
      "end": 99.83333333333333,
      "treatment": "camera-switchback",
      "lyrics": "Cain said to Abel his brother, Let us go out to the plain. There in the plain he rose against Abel"
    },
