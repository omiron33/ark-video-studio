      "id": "g4-scene-027",
      "start": 99.83333333333333,
      "end": 102.26666666666667,
      "treatment": {
        "id": "photographic-club-strike",
        "description": "Preserved club attack: hard upper-left word strikes leave the physical struggle visible."
      },
      "lyrics": "and killed his brother."
    },
    {
      "id": "g4-scene-028",
      "start": 102.26666666666667,
      "end": 105.13333333333334,
      "treatment": {
        "id": "photographic-divine-question",
        "description": "Preserved embodied judgment: restrained left-aligned questioning over the accepted human Christophany."
      },
      "lyrics": "The Lord God asked Cain,"
    },
    {
      "id": "g4-scene-029",
      "start": 105.13333333333334,
      "end": 108.26666666666667,
      "treatment": "camera-tunnel",
      "lyrics": "Where is Abel, your brother?"
    },
    {
      "id": "g4-scene-030",
      "start": 108.26666666666667,
      "end": 111.03333333333333,
      "treatment": "redaction-slab",
      "lyrics": "I do not know, he said;"
    },
    {
      "id": "g4-scene-031",
      "start": 111.03333333333333,
      "end": 113.53333333333333,
      "treatment": "camera-hinge",
      "lyrics": "am I my brother's keeper?"
    },
    {
      "id": "g4-scene-032",
      "start": 113.53333333333333,
      "end": 116.56666666666666,
      "treatment": "incision",
      "lyrics": "What have you done? the Lord said."
    },
    {
      "id": "g4-scene-033",
      "start": 116.56666666666666,
      "end": 120.96666666666667,
      "treatment": "echo-cry",
      "lyrics": "Your brother's blood has a voice; it cries to Me from the ground."
    },
    {
      "id": "g4-scene-035",
      "start": 120.96666666666667,
      "end": 124,
      "treatment": "concentric-rupture",
      "lyrics": "Now you are cursed from the earth;"
    },
    {
      "id": "g4-scene-036",
      "start": 124,
      "end": 125.03333333333333,
      "treatment": "camera-micro",
      "lyrics": "she opened her mouth"
    },
    {
      "id": "g4-scene-037",
      "start": 125.03333333333333,
      "end": 129.7,
      "treatment": "camera-spiral",
      "lyrics": "to take your brother's blood from your hand."
    },
    {
      "id": "g4-scene-039",
      "start": 129.7,
      "end": 132.46666666666667,
      "treatment": "torn-monument",
      "lyrics": "When you till the earth,"
    },
    {
      "id": "g4-scene-040",
      "start": 132.46666666666667,
      "end": 135.6,
      "treatment": "negative-space",
      "lyrics": "she will no longer yield her strength."
    },
    {
      "id": "g4-scene-041",
      "start": 135.6,
      "end": 141.03333333333333,
      "treatment": "string-pluck",
      "lyrics": "You will groan and tremble"
    },
    {
      "id": "g4-scene-042",
      "start": 141.03333333333333,
      "end": 145.6,
      "treatment": "shadow-procession",
      "lyrics": "upon the earth."
    },
    {
      "id": "g4-scene-043",
      "start": 145.6,
      "end": 150.66666666666666,
      "treatment": "camera-dolly",
      "lyrics": "Cain said to the Lord God,"
    },
    {
      "id": "g4-scene-044",
      "start": 150.66666666666666,
      "end": 155.66666666666666,
      "treatment": "falling-weight",
      "lyrics": "My crime is too great for me to be forgiven."
    },
    {
      "id": "g4-scene-046",
      "start": 155.66666666666666,
      "end": 158.4,
      "treatment": "threshold-exile",
      "lyrics": "If You cast me out today"
    },
    {
      "id": "g4-scene-047",
      "start": 158.4,
      "end": 160.86666666666667,
      "treatment": "camera-pullback",
      "lyrics": "from the face of the earth,"
    },
    {
      "id": "g4-scene-048",
      "start": 160.86666666666667,
      "end": 162.73333333333332,
      "treatment": "eclipse-disc",
      "lyrics": "hidden from Your presence,"
    },
    {
      "id": "g4-scene-049",
      "start": 162.73333333333332,
      "end": 165.16666666666666,
      "treatment": "camera-stairwell",
      "lyrics": "groaning and trembling on the earth,"
    },
    {
      "id": "g4-scene-050",
      "start": 165.16666666666666,
      "end": 168.9,
      "treatment": "word-strike",
      "lyrics": "whoever finds me will kill me."
    },
    {
      "id": "g4-scene-051",
      "start": 168.9,
      "end": 171.73333333333332,
      "treatment": "split-verdict",
      "lyrics": "The Lord God said, Not so."
    },
    {
      "id": "g4-scene-052",
      "start": 171.73333333333332,
      "end": 172.96666666666667,
      "treatment": "camera-rack",
      "lyrics": "Whoever kills Cain"
    },
    {
      "id": "g4-scene-053",
      "start": 172.96666666666667,
      "end": 176.5,
      "treatment": "tally-vengeance",
      "lyrics": "will suffer vengeance sevenfold."
    },
    {
      "id": "g4-scene-054",
      "start": 176.5,
      "end": 179.2,
      "treatment": "mark-seal",
      "lyrics": "The Lord set a mark upon Cain,"
    },
    {
      "id": "g4-scene-055",
      "start": 179.2,
      "end": 184.03333333333333,
      "treatment": "monolith-rise",
      "lyrics": "so none who found him would kill him."
    },
    {
