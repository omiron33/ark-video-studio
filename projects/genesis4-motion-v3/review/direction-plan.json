      "id": "g4-scene-005",
      "start": 35.03333333333333,
      "end": 37.96666666666667,
      "treatment": "camera-canyon",
      "lyrics": "while Cain worked the ground."
    },
    {
      "id": "g4-scene-006",
      "start": 37.96666666666667,
      "end": 40.166666666666664,
      "treatment": "camera-rail",
      "lyrics": "After a time Cain brought"
    },
    {
      "id": "g4-scene-007",
      "start": 40.166666666666664,
      "end": 41.4,
      "treatment": "forge-assembly",
      "lyrics": "fruit of the earth"
    },
    {
