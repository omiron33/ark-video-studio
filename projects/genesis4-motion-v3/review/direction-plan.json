      "start": 27.466666666666665,
      "end": 32.3,
      "treatment": "balance-offering",
      "lyrics": "Again she bore, his brother Abel."
    },
    {
      "id": "g4-scene-004",
      "start": 32.3,
      "end": 35.03333333333333,
      "treatment": "word-orbit",
      "lyrics": "Abel kept the sheep,"
    },
