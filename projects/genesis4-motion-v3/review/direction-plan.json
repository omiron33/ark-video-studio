      "id": "g4-scene-063",
      "start": 212.16666666666666,
      "end": 221.3,
      "treatment": "genesis-lineage-cain",
      "lyrics": "To Enoch was born Gaidad. Gaidad fathered Maleleel, Maleleel fathered Mathusala, and Mathusala fathered Lamech."
    },
    {
      "id": "g4-scene-067",
      "start": 221.3,
      "end": 223.23333333333332,
      "treatment": "split-verdict",
      "lyrics": "Lamech took two wives:"
    },
    {
      "id": "g4-scene-068",
      "start": 223.23333333333332,
      "end": 225.6,
      "treatment": "crescent-sweep",
      "lyrics": "one was named Ada, the other Sella."
    },
    {
      "id": "g4-scene-070",
      "start": 225.6,
      "end": 226.56666666666666,
      "treatment": "camera-micro",
      "lyrics": "Ada bore Jobel,"
    },
