      "id": "g4-scene-079",
      "start": 240.33333333333334,
      "end": 243.5,
      "treatment": "camera-hinge",
      "lyrics": "Lamech said to Ada and Sella,"
    },
    {
      "id": "g4-scene-080",
      "start": 243.5,
      "end": 246.2,
      "treatment": "echo-cry",
      "lyrics": "Hear my voice, wives of Lamech;"
    },
    {
      "id": "g4-scene-081",
      "start": 246.2,
      "end": 248,
      "treatment": "camera-tunnel",
      "lyrics": "listen to my words."
    },
