[
 {
  "i": 0,
  "text": "The heavens and the earth were finished,",
  "start": 11.860825,
  "end": 15.061048,
  "n": 7
 },
 {
  "i": 1,
  "text": "the whole world of them.",
  "start": 16.701162,
  "end": 19.441352,
  "n": 5
 },
 {
  "i": 2,
  "text": "On the sixth day God finished",
  "start": 21.821518,
  "end": 24.281689,
  "n": 6
 },
 {
  "i": 3,
  "text": "all the work He had made;",
  "start": 25.521775,
  "end": 27.861938,
  "n": 6
 },
 {
  "i": 4,
  "text": "on the seventh He ceased",
  "start": 31.142166,
  "end": 32.942291,
  "n": 5
 },
 {
  "i": 5,
  "text": "from all His work.",
  "start": 33.042298,
  "end": 34.062369,
  "n": 4
 },
 {
  "i": 6,
  "text": "God blessed the seventh day",
  "start": 34.962432,
  "end": 37.462606,
  "n": 5
 },
 {
  "i": 7,
  "text": "and made it holy,",
  "start": 37.642618,
  "end": 39.282732,
  "n": 4
 },
 {
  "i": 8,
  "text": "for on that day He ceased",
  "start": 41.602894,
  "end": 43.883052,
  "n": 6
 },
 {
  "i": 9,
  "text": "from all the work He began.",
  "start": 45.14314,
  "end": 48.463371,
  "n": 6
 },
 {
  "i": 10,
  "text": "This is the story of heaven and earth",
  "start": 52.103624,
  "end": 56.22391,
  "n": 8
 },
 {
  "i": 11,
  "text": "when they were made,",
  "start": 57.123973,
  "end": 58.584075,
  "n": 4
 },
 {
  "i": 12,
  "text": "when the Lord God made",
  "start": 59.564143,
  "end": 61.404271,
  "n": 5
 },
 {
  "i": 13,
  "text": "the heavens and the earth.",
  "start": 62.304333,
  "end": 63.744433,
  "n": 5
 },
 {
  "i": 14,
  "text": "Before the field's herbs grew,",
  "start": 64.564491,
  "end": 66.244607,
  "n": 5
 },
 {
  "i": 15,
  "text": "before its grasses rose,",
  "start": 67.184673,
  "end": 70.084874,
  "n": 4
 },
 {
  "i": 16,
  "text": "God had sent no rain on earth,",
  "start": 71.885,
  "end": 74.505182,
  "n": 7
 },
 {
  "i": 17,
  "text": "and no man was there to till it.",
  "start": 75.865276,
  "end": 79.545532,
  "n": 8
 },
 {
  "i": 18,
  "text": "A fountain rose from the earth",
  "start": 79.645539,
  "end": 81.865694,
  "n": 6
 },
 {
  "i": 19,
  "text": "and watered all its face.",
  "start": 83.10578,
  "end": 85.26593,
  "n": 5
 },
 {
  "i": 20,
  "text": "God formed the man from earth's dust",
  "start": 90.00626,
  "end": 92.266417,
  "n": 7
 },
 {
  "i": 21,
  "text": "and breathed life upon his face;",
  "start": 92.326421,
  "end": 94.786592,
  "n": 6
 },
 {
  "i": 22,
  "text": "the man became a living soul.",
  "start": 95.386634,
  "end": 99.406914,
  "n": 6
 },
 {
  "i": 23,
  "text": "God planted a garden eastward",
  "start": 103.007164,
  "end": 105.127312,
  "n": 5
 },
 {
  "i": 24,
  "text": "in Edem,",
  "start": 105.187316,
  "end": 107.387469,
  "n": 2
 },
 {
  "i": 25,
  "text": "and placed the man He formed",
  "start": 108.087518,
  "end": 110.227666,
  "n": 6
 },
 {
  "i": 26,
  "text": "within it.",
  "start": 110.327673,
  "end": 110.867711,
  "n": 2
 },
 {
  "i": 27,
  "text": "From the ground He raised every tree",
  "start": 112.087796,
  "end": 114.287949,
  "n": 7
 },
 {
  "i": 28,
  "text": "beautiful to see and good to eat;",
  "start": 114.727979,
  "end": 116.908131,
  "n": 7
 },
 {
  "i": 29,
  "text": "the tree of life stood in the midst,",
  "start": 117.46817,
  "end": 119.808333,
  "n": 8
 },
 {
  "i": 30,
  "text": "and the tree of knowing good and evil.",
  "start": 119.988345,
  "end": 122.488519,
  "n": 8
 },
 {
  "i": 31,
  "text": "A river flowed out of Edem",
  "start": 123.06856,
  "end": 125.22871,
  "n": 6
 },
 {
  "i": 32,
  "text": "to water the garden;",
  "start": 125.928758,
  "end": 127.748885,
  "n": 4
 },
 {
  "i": 33,
  "text": "from there it parted",
  "start": 127.868893,
  "end": 129.228988,
  "n": 4
 },
 {
  "i": 34,
  "text": "into four heads.",
  "start": 129.328995,
  "end": 130.529078,
  "n": 3
 },
 {
  "i": 35,
  "text": "The first was Phisom,",
  "start": 131.149122,
  "end": 133.049254,
  "n": 4
 },
 {
  "i": 36,
  "text": "circling all Evilat,",
  "start": 133.249268,
  "end": 135.269408,
  "n": 3
 },
 {
  "i": 37,
  "text": "the land where gold is found.",
  "start": 135.72944,
  "end": 137.909592,
  "n": 6
 },
 {
  "i": 38,
  "text": "That land's gold is good;",
  "start": 138.30962,
  "end": 140.409766,
  "n": 5
 },
 {
  "i": 39,
  "text": "carbuncle and emerald",
  "start": 140.749789,
  "end": 142.069881,
  "n": 3
 },
 {
  "i": 40,
  "text": "are found there too.",
  "start": 142.829934,
  "end": 144.290035,
  "n": 4
 },
 {
  "i": 41,
  "text": "The second river was Geon,",
  "start": 144.490049,
  "end": 146.23017,
  "n": 5
 },
 {
  "i": 42,
  "text": "circling all Ethiopia.",
  "start": 146.610197,
  "end": 149.290383,
  "n": 3
 },
 {
  "i": 43,
  "text": "The third was Tigris,",
  "start": 149.730414,
  "end": 151.430532,
  "n": 4
 },
 {
  "i": 44,
  "text": "flowing beside Assyria;",
  "start": 151.790557,
  "end": 154.110719,
  "n": 3
 },
 {
  "i": 45,
  "text": "the fourth was Euphrates.",
  "start": 154.230727,
  "end": 158.531026,
  "n": 4
 },
 {
  "i": 46,
  "text": "The Lord God took the man",
  "start": 159.151069,
  "end": 160.911191,
  "n": 6
 },
 {
  "i": 47,
  "text": "and set him in the garden of Delight,",
  "start": 161.071203,
  "end": 163.951403,
  "n": 8
 },
 {
  "i": 48,
  "text": "to tend it and to keep it.",
  "start": 164.411435,
  "end": 166.531582,
  "n": 7
 },
 {
  "i": 49,
  "text": "The Lord God charged Adam:",
  "start": 166.671592,
  "end": 169.131763,
  "n": 5
 },
 {
  "i": 50,
  "text": "From every tree in the garden",
  "start": 169.571794,
  "end": 171.53193,
  "n": 6
 },
 {
  "i": 51,
  "text": "you may freely eat.",
  "start": 172.031965,
  "end": 173.9721,
  "n": 4
 },
 {
  "i": 52,
  "text": "But from the tree of knowing",
  "start": 174.492136,
  "end": 175.632215,
  "n": 6
 },
 {
  "i": 53,
  "text": "good and evil, do not eat;",
  "start": 175.652217,
  "end": 178.072385,
  "n": 6
 },
 {
  "i": 54,
  "text": "on the day you eat of it",
  "start": 179.29247,
  "end": 180.772573,
  "n": 7
 },
 {
  "i": 55,
  "text": "you will surely die.",
  "start": 183.412756,
  "end": 185.992936,
  "n": 4
 },
 {
  "i": 56,
  "text": "The Lord God said,",
  "start": 189.21316,
  "end": 190.633259,
  "n": 4
 },
 {
  "i": 57,
  "text": "It is not good for man to be alone;",
  "start": 191.273303,
  "end": 194.033495,
  "n": 9
 },
 {
  "i": 58,
  "text": "let us make a helper",
  "start": 195.273581,
  "end": 197.193715,
  "n": 5
 },
 {
  "i": 59,
  "text": "suited to him.",
  "start": 197.873762,
  "end": 199.033843,
  "n": 3
 },
 {
  "i": 60,
  "text": "God formed the beasts of the field",
  "start": 199.533878,
  "end": 201.974047,
  "n": 7
 },
 {
  "i": 61,
  "text": "and birds of the sky from the earth.",
  "start": 202.01405,
  "end": 204.654234,
  "n": 8
 },
 {
  "i": 62,
  "text": "He brought them all to Adam;",
  "start": 204.974256,
  "end": 207.434427,
  "n": 6
 },
 {
  "i": 63,
  "text": "what he called each living thing",
  "start": 208.694515,
  "end": 210.63465,
  "n": 6
 },
 {
  "i": 64,
  "text": "became its name.",
  "start": 210.834664,
  "end": 212.234761,
  "n": 3
 },
 {
  "i": 65,
  "text": "Adam named the cattle,",
  "start": 212.494779,
  "end": 213.894877,
  "n": 4
 },
 {
  "i": 66,
  "text": "the birds and every wild beast;",
  "start": 214.114892,
  "end": 216.335046,
  "n": 6
 },
 {
  "i": 67,
  "text": "but for himself he found",
  "start": 216.595064,
  "end": 219.195245,
  "n": 5
 },
 {
  "i": 68,
  "text": "no helper like him.",
  "start": 219.41526,
  "end": 221.775425,
  "n": 4
 },
 {
  "i": 69,
  "text": "God brought a deep trance on Adam;",
  "start": 222.835498,
  "end": 225.795704,
  "n": 7
 },
 {
  "i": 70,
  "text": "while he slept, He took a rib",
  "start": 227.575828,
  "end": 229.315949,
  "n": 7
 },
 {
  "i": 71,
  "text": "and closed the flesh in its place.",
  "start": 229.75598,
  "end": 232.116144,
  "n": 7
 },
 {
  "i": 72,
  "text": "From that rib God formed a woman",
  "start": 232.356161,
  "end": 236.556453,
  "n": 7
 },
 {
  "i": 73,
  "text": "and brought her to Adam.",
  "start": 239.616666,
  "end": 241.216777,
  "n": 5
 },
 {
  "i": 74,
  "text": "Adam: Now this is bone of my bones",
  "start": 243.596942,
  "end": 247.137189,
  "n": 8
 },
 {
  "i": 75,
  "text": "and flesh of my flesh.",
  "start": 247.537216,
  "end": 249.497353,
  "n": 5
 },
 {
  "i": 76,
  "text": "Eve: She shall be called woman,",
  "start": 249.517354,
  "end": 252.057531,
  "n": 6
 },
 {
  "i": 77,
  "text": "for she was taken from her husband.",
  "start": 252.077532,
  "end": 254.77772,
  "n": 7
 },
 {
  "i": 78,
  "text": "Adam and Eve:",
  "start": 255.417764,
  "end": 256.177817,
  "n": 3
 },
 {
  "i": 79,
  "text": "So a man will leave",
  "start": 256.197819,
  "end": 257.057879,
  "n": 5
 },
 {
  "i": 80,
  "text": "his father and his mother,",
  "start": 257.977943,
  "end": 259.598055,
  "n": 5
 },
 {
  "i": 81,
  "text": "cling to his wife,",
  "start": 260.858143,
  "end": 262.298243,
  "n": 4
 },
 {
  "i": 82,
  "text": "and the two will be one flesh.",
  "start": 263.298313,
  "end": 264.498396,
  "n": 7
 },
 {
  "i": 83,
  "text": "Adam and Eve:",
  "start": 264.69841,
  "end": 265.55847,
  "n": 3
 },
 {
  "i": 84,
  "text": "They both were naked,",
  "start": 266.498535,
  "end": 267.798626,
  "n": 4
 },
 {
  "i": 85,
  "text": "Adam and his wife,",
  "start": 269.098716,
  "end": 270.198793,
  "n": 4
 },
 {
  "i": 86,
  "text": "and neither felt shame.",
  "start": 271.45888,
  "end": 283.319705,
  "n": 4
 }
]