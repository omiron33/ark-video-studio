[
  {
    "text": "Then the Lord said to Noah,",
    "start": 10.0,
    "last_end": 21.24,
    "lines": [
      "Then the Lord",
      "said to Noah,"
    ],
    "end": 21.639999999999997,
    "entrance": "tracking",
    "exit": "fade",
    "shake_time": null,
    "index": 0
  },
  {
    "text": "Come into the ark, You and all your household,",
    "start": 24.11,
    "last_end": 30.56,
    "lines": [
      "Come into the ark, You",
      "and all your household,"
    ],
    "end": 30.959999999999997,
    "entrance": "slide_right",
    "exit": "slide_left",
    "shake_time": null,
    "index": 1
  },
  {
    "text": "For I have seen you walking rightly Before Me in this generation.",
    "start": 31.08,
    "last_end": 36.44,
    "lines": [
      "For I have seen you walking rightly",
      "Before Me in this generation."
    ],
    "end": 36.44,
    "entrance": "slide_left",
    "exit": "scale",
    "shake_time": null,
    "index": 2
  },
  {
    "text": "Take with you the clean animals, Seven pairs of every kind, Male and female together.",
    "start": 36.44,
    "last_end": 47.02,
    "lines": [
